        <file alias="save.svg">icons/save.svg</file>
        <file alias="open.svg">icons/open.svg</file>
        <file alias="flow.svg">icons/flow.svg</file>
        <file alias="route.svg">icons/route.svg</file>
    </qresource>
</RCC>
